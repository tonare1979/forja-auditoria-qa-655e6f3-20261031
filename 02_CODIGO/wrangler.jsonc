{
  "name": "forja-v11-rc3-preview-isolada",
  "main": "src/index.js",
  "compatibility_date": "2026-10-10",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "forja-v11-rc3-laboratorio",
      "database_id": "402315ff-3833-4060-91b6-8c6bd3884642",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "forja-v11-rc3-fotos-lab"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
